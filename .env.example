# Copy to .env and adjust. Never commit a real .env.

# --- App ---
IPA_ENV=local
IPA_LOG_LEVEL=INFO
IPA_LOG_JSON=true
IPA_API_PORT=8000
IPA_SECRET_KEY=change-me
IPA_MAX_UPLOAD_MB=200
IPA_ALLOWED_MIME=application/pdf,image/png,image/jpeg,image/tiff,application/zip
IPA_CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
IPA_POSTGRES_DSN=postgresql+asyncpg://ipa:ipa@postgres:5432/ipa
IPA_POSTGRES_POOL_SIZE=10
IPA_POSTGRES_ECHO=false

# --- MongoDB ---
IPA_MONGO_URI=mongodb://mongo:27017
IPA_MONGO_DB=ipa

# --- Redis ---
IPA_REDIS_URL=redis://redis:6379/0
IPA_CELERY_BROKER_URL=redis://redis:6379/1
IPA_CELERY_RESULT_BACKEND=redis://redis:6379/2
IPA_CACHE_TTL_S=3600

# --- MinIO ---
IPA_S3_ENDPOINT=http://minio:9000
# Endpoint used for presigned download URLs when IPA_S3_ENDPOINT is only
# reachable inside the compose network (e.g. http://localhost:9000).
# Empty = same as IPA_S3_ENDPOINT.
IPA_S3_PUBLIC_ENDPOINT=
IPA_S3_ACCESS_KEY=minioadmin
IPA_S3_SECRET_KEY=minioadmin
IPA_S3_BUCKET=ipa-documents
IPA_S3_SECURE=false
IPA_S3_PRESIGN_EXPIRY_S=900

# --- NVIDIA NIM (OpenAI-compatible) ---
# Model IDs are intentionally blank: pick them from the NVIDIA catalogue.
# Enable the matching IPA_FEATURE_* flag below once a model ID is set — startup
# fails fast if a feature is enabled while its model ID is empty.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=
NVIDIA_VLM_MODEL=
NVIDIA_EMBED_MODEL=
NVIDIA_EMBED_DIM=1024
NVIDIA_TIMEOUT_S=120
NVIDIA_MAX_RETRIES=3

# --- Feature switches (default off so a fresh clone boots with blank models) ---
IPA_FEATURE_EXTRACTION_ENABLED=false
IPA_FEATURE_VLM_OCR_ENABLED=false
IPA_FEATURE_EMBEDDING_ENABLED=false

# --- OCR ---
IPA_OCR_TEXT_LAYER_MIN_CHARS=120
IPA_OCR_PAGE_DPI=220
IPA_OCR_FALLBACK_ENABLED=true
IPA_TESSERACT_LANGS=eng+spa

# --- Pipeline ---
IPA_STEP_MAX_ATTEMPTS=3
IPA_STEP_RETRY_BACKOFF_S=15
IPA_CHUNK_TOKENS=512
IPA_CHUNK_OVERLAP=64

# --- Observability ---
OTEL_SERVICE_NAME=ipa-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_always_on
IPA_OTEL_CONSOLE_EXPORT=false
